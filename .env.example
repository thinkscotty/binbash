# Copy to .env and edit. `chmod 600 .env` -- it holds your password.
#
#     cp .env.example .env && chmod 600 .env

# The uid/gid that owns ./data. Check yours with:  id -u   and   id -g
PUID=1000
PGID=1000

# Your timezone, or timestamps read as UTC. `timedatectl` shows the host's.
TZ=America/New_York

# Host port. binbash is published on 127.0.0.1 only; put a proxy in front.
BINBASH_PORT=8080

# Used once, to create your account on first start. At least 8 characters.
# Delete this line after your first successful login -- from then on binbash
# reads the hashed password from the database and ignores this entirely.
BINBASH_PASSWORD=change-this-to-something-long

# Stamped into the binary and shown on the settings page. Set it to the tag you
# built from, e.g. v1.4.0, so you can tell which build is running.
BINBASH_VERSION=dev
